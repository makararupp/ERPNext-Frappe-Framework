# ERPNext Docker settings - edit these, then run "ERPNext: Start"

# ERPNext image version (see https://hub.docker.com/r/frappe/erpnext/tags)
ERPNEXT_VERSION=v16.12.0

# Port on your PC -> open http://localhost:8080
# Change to 8090 etc. if 8080 is already in use
HTTP_PORT=8080

# Login password for the "Administrator" user (only used when the site is first created)
ADMIN_PASSWORD=admin

# MariaDB root password (only used when the database is first created)
DB_ROOT_PASSWORD=admin
